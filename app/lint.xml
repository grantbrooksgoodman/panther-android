<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint configuration for the app module. -->
<lint>
    <!-- Regions that use another country's flag share an identical
         image by design (fr/mf, bv/no/sj, um/us, and others). -->
    <issue id="IconDuplicates">
        <ignore path="src/main/res/drawable-nodpi/flag_*.png" />
    </issue>

    <!-- The launcher rasterizes its icon once and caches the bitmap, so the
         long path data of the launcher layers costs nothing at runtime. -->
    <issue id="VectorPath">
        <ignore path="src/main/res/drawable/ic_launcher_*.xml" />
    </issue>
</lint>
