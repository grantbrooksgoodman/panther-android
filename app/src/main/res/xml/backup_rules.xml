<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and earlier; data_extraction_rules.xml
   holds the same rules for Android 12 and later. Everything is backed up
   except the encrypted device identifier preferences, whose Android
   Keystore key never leaves the device, and downloaded media, which can be
   fetched again and would count against the 25 MB backup quota.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="device_id.xml" />
    <exclude domain="file" path="media" />
</full-backup-content>
