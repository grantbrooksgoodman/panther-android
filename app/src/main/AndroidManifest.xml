<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Saving media on Android 9 writes to the public media
         directories, which needs this permission; Android 10 and
         later write through the media store without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- The app shows no ads and never reads the advertising ID, so the
         advertising permissions that Firebase Analytics merges in are
         removed, and ad ID collection is turned off below. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Back is delivered through the platform's back callback on
         every version that offers one, as it is by default on Android
         16 and later for this target SDK. -->
    <application
        android:name=".bundle.delegates.PantherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Panther">
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- While the app is in the background, FCM posts notification
             messages itself. Without these, it posts them to its own
             fallback channel with the launcher icon. The channel ID
             matches PantherMessagingService.MESSAGES_CHANNEL_ID, and
             PantherApplication creates the channel at launch. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />

        <!-- The activity is portrait-only. On large screens, Android 16
             and later ignore the portrait lock: rotation counts as a
             size change there, and CompatibilityFrame keeps the content
             at a phone's proportions. The activity stays resizable, so
             a display size change or a fold resizes it rather than
             putting it in size compatibility mode.

             The activity handles appearance, size, text size, display
             size, and input device changes itself, so the signed-in
             session's first-appearance work, including its network
             requests, runs once. A language change recreates the
             activity. -->
        <activity
            android:name=".bundle.delegates.MainActivity"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Panther"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notificationextension.PantherMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
