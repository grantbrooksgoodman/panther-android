root = true

[*.{kt,kts}]
# Composable functions are named in PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Extension and constants files are named for the type they extend
# ("String+AppContentExtensions.kt") and for their consumer.
ktlint_standard_filename = disabled

# Declarations are ordered by access level, then by static and
# mutable tiers, with blank lines between the tiers.
ktlint_standard_property-naming = enabled
ktlint_standard_no-blank-line-in-list = disabled

# Lines are at most 160 characters. Matches MaxLineLength in
# config/detekt/detekt.yml and sets Android Studio's right margin.
max_line_length = 160

# Signatures and expression bodies wrapped by hand stay wrapped.
ktlint_standard_function-signature = disabled

# Branches of a `when` take braces only when their bodies need them.
ktlint_standard_when-entry-bracing = disabled

[**/lzfse/LzfseTables.kt]
# The lookup tables keep several values per row.
ktlint_standard_argument-list-wrapping = disabled
