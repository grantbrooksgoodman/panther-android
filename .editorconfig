root = true

[*.{kt,kts}]
# Jetpack Compose @Composable functions are conventionally PascalCase, so exempt
# them from ktlint's function-naming rule (mirrors the detekt config in
# config/detekt/detekt.yml). Revisit with STYLE_RULES_ANDROID.md in Phase 1.
ktlint_function_naming_ignore_when_annotated_with = Composable
