root = true

[*.{kt,kts}]
# Jetpack Compose @Composable functions are conventionally PascalCase, so exempt
# them from ktlint's function-naming rule (mirrors the detekt config in
# config/detekt/detekt.yml). See STYLE_RULES_ANDROID.md.
ktlint_function_naming_ignore_when_annotated_with = Composable

# STYLE_RULES_ANDROID.md §2: extension/constants files use iOS-parity names
# ("String+AppContentExtensions.kt"), which the filename rule rejects.
ktlint_standard_filename = disabled

# STYLE_RULES_ANDROID.md §9: declarations order by access/static/mutability
# tiers with blank-line separation, which this rule fights.
ktlint_standard_property-naming = enabled
ktlint_standard_no-blank-line-in-list = disabled

# iOS SwiftLint line_length (160). Matches MaxLineLength in
# config/detekt/detekt.yml and sets Android Studio's right margin.
max_line_length = 160

# iOS SwiftFormat never joins lines that were wrapped by hand. This rule
# joins wrapped signatures and expression bodies that fit on one line,
# against the >60-character expansion rule in STYLE_RULES_ANDROID.md §10.
ktlint_standard_function-signature = disabled

# Swift switch cases take no braces, and iOS SwiftFormat adds none. This rule
# braces every branch of a `when` once any branch spans several lines.
ktlint_standard_when-entry-bracing = disabled

[**/lzfse/LzfseTables.kt]
# iOS SwiftFormat keeps several values per row in a list wrapped before its
# first element. This rule puts every value of these lookup tables on its
# own line.
ktlint_standard_argument-list-wrapping = disabled
