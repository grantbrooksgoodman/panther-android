# Release signing configuration for the "Hello" Android app.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in
# the values for your upload keystore. When `keystore.properties` is absent,
# the release build is produced unsigned, so a fresh checkout still builds.
#
# Generate an upload keystore with:
#   keytool -genkeypair -v -keystore hello-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias hello-upload
#
# Then enroll in Play App Signing on first upload so Google manages the
# final app-signing key.

# Path to the keystore file, relative to the repo root.
storeFile=hello-upload.jks

# Keystore and key credentials.
storePassword=CHANGEME
keyAlias=hello-upload
keyPassword=CHANGEME
